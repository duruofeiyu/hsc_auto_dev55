# ===== 模型配置（当前使用：智谱 GLM 视觉模型，国产）=====
# key 获取：https://open.bigmodel.cn/ → 用户中心 → API Keys
# 注意：智谱必须用 MIDSCENE_MODEL_FAMILY 指定家族，
#       不存在 MIDSCENE_USE_GLM_VL 这个开关。
MIDSCENE_MODEL_BASE_URL="https://open.bigmodel.cn/api/paas/v4"
MIDSCENE_MODEL_API_KEY="你的智谱key（形如 xxxxxxxx.yyyyyyyy）"
MIDSCENE_MODEL_NAME="glm-4.6v"
MIDSCENE_MODEL_FAMILY="glm-v"

# 配好后先验证：npm run check:model
#   · 401 令牌已过期或验证不正确  → key 无效（多半是占位符没替换）
#   · 模型不存在 / model not found → 把 NAME 换成 glm-4v-plus 再试

# ===== 桥接登录脚本（bridge_login.mjs）用到的凭证 =====
# 登录页有验证码，全自动本来就不稳；桥接模式复用已登录会话才是正解，
# 这里只是会话过期时的兜底。密码绝不写进脚本，只放这里（.env 已 gitignore）。
HSC_LOGIN_URL="https://192.168.124.55:26400"
HSC_USER="你的测试账号"
HSC_PASS="你的密码"
# 验证码读错时自动刷新重试的次数（默认 3）
HSC_LOGIN_ATTEMPTS="3"

# ===== 已弃用的方案（留作记录，别再用）=====
# ① 阿里云百炼 Qwen-VL：需充值，额度用尽会报 400 Arrearage
#    OPENAI_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
#    OPENAI_API_KEY="sk-你的key"
#    MIDSCENE_MODEL_NAME="qwen-vl-plus"
#    MIDSCENE_USE_QWEN_VL=1
# ② 本地 ollama：2026-09-09 实测 8GB M1 跑 3B 视觉模型直接卡死机，弃用。
#    即便 24GB+ 内存机器，也要把 num_ctx 加到 16384 才能处理 midscene 截图。

# ===== 可选：调试时打印 token 消耗与耗时 =====
# DEBUG=midscene:ai:profile:stats
