# ============================================================
# HSC 自动化测试 - 本机敏感配置模板
# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，不入库）：
#   cp .env.example .env  然后编辑
# 说明：config.py 顶部会自动加载 .env；已 export / CI 注入的变量优先，不被覆盖。
# ============================================================

# ---- 环境切换（默认 55 开发环境）----
# HSC_ENV=55

# ---- 接口测试默认业务账号（chenyh，业务模块用）----
# 注意：接口侧 HSC_TEST_PASSWORD 是加密串，UI 登录 HSC_UI_PASSWORD 必须是明文密码
# HSC_TEST_ACCOUNT=chenyh
# HSC_TEST_PASSWORD=<chenyh 接口加密串密码>
# HSC_TOKEN=<chenyh 的 JWT token>

# ---- UI 登录账号（明文密码，必填）----
# HSC_UI_USER=chenyh
# HSC_UI_PASSWORD=<chenyh 明文密码>

# ---- 各角色账号密码（权限收口后的多角色测试；UI 用明文，接口侧由 export_token 导出）----
# HSC_UI_ADMIN_USER=admin
# HSC_UI_ADMIN_PASSWORD=<admin 明文密码>
# HSC_UI_SYSTEM_SECURITY_USER=secadmin
# HSC_UI_SYSTEM_SECURITY_PASSWORD=<secadmin 明文密码>
# HSC_UI_AUDIT_USER=audit
# HSC_UI_AUDIT_PASSWORD=<audit 明文密码>
# HSC_UI_COMMON_ADMIN_USER=ceshi
# HSC_UI_COMMON_ADMIN_PASSWORD=<ceshi 明文密码>
# HSC_UI_OPERATION_USER=chuli
# HSC_UI_OPERATION_PASSWORD=<chuli 明文密码>

# ---- 系统管理模块接口角色（默认已正确，一般无需改）----
# HSC_SYSTEM_ADMIN_ROLE=admin
# HSC_SYSTEM_SECURITY_ROLE=system_security
