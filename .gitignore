# Token 文件（安全）
token.txt
token_*.txt
# 浏览器实时抓取的认证头（含会话 Cookie，不可入库）
auth_headers.json
auth_headers_*.json

# UI 登录态（storage_state，含会话 cookie，不可入库）
ui/tests/.auth/

# 临时文件
*.tmp
*.bak
*.bak*

# 临时验证码截图证据（一次性调试用，不入库）
captcha_*.jpg

# 运行时凭证统一目录（token/auth头，含会话凭据，不入库）
.secrets/
